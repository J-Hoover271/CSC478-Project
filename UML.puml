@startuml UNO_Simple
title UNO Class Diagram

skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #1F2937
skinparam ArrowThickness 1.75
skinparam PackageBorderColor #1F2937
skinparam PackageBorderThickness 1
skinparam PackageBackgroundColor #F8FAFC
skinparam nodesep 60
skinparam ranksep 90

package "uno.cards" {
    enum CardColor {
        RED
        BLUE
        GREEN
        YELLOW
        NONE

        +getLabel() : String
    }

    enum CardValue {
        ZERO
        ONE
        TWO
        THREE
        FOUR
        FIVE
        SIX
        SEVEN
        EIGHT
        NINE
        SKIP
        REVERSE
        DRAW_TWO
        WILD
        WILD_DRAW_FOUR

        +getLabel() : String
    }

    enum CardPoints {
        INSTANCE

        +getPoints(card : Card) : int
    }

    interface CardEffectContext {
        +skipNextPlayer() : void
        +reverseDirection() : void
        +nextPlayerDraws(count : int) : void
    }

    abstract class Card {
        -color : CardColor
        -value : CardValue

        ~Card(color : CardColor, value : CardValue)
        +getColor() : CardColor
        +getValue() : CardValue
        +getPoints() : int
        +isWild() : boolean
        +toString() : String
        {abstract} +play(ctx : CardEffectContext) : void
    }
    class NumberCard {
        +NumberCard(color : CardColor, value : CardValue)
        +play(ctx : CardEffectContext) : void
    }
    class SkipCard {
        +SkipCard(color : CardColor)
        +play(ctx : CardEffectContext) : void
    }
    class ReverseCard {
        +ReverseCard(color : CardColor)
        +play(ctx : CardEffectContext) : void
    }
    class DrawTwoCard {
        +DrawTwoCard(color : CardColor)
        +play(ctx : CardEffectContext) : void
    }
    class WildCard {
        +WildCard()
        +play(ctx : CardEffectContext) : void
    }
    class WildDrawFourCard {
        +WildDrawFourCard()
        +play(ctx : CardEffectContext) : void
    }

        Card <|-- NumberCard
        Card <|-- SkipCard
        Card <|-- ReverseCard
        Card <|-- DrawTwoCard
        Card <|-- WildCard
        Card <|-- WildDrawFourCard

        Card --> CardColor
        Card --> CardValue
        Card ..> CardPoints
        Card ..> CardEffectContext
}

package "uno.model" {
    class Deck {
        -deck : List<Card>

        +Deck()
        +shuffle() : void
        +draw() : Card
        +isEmpty() : boolean
        +restock(cards : List<Card>) : void
    }
    class DiscardPile {
        -discardPile : List<Card>
        -activeColor : CardColor

        +DiscardPile(deck : Deck)
        +place(card : Card) : void
        +getTopCard() : Card
        +getActiveColor() : CardColor
        +setActiveColor(color : CardColor) : void
        +refillDeck() : List<Card>
    }
    class Hand {
        -hand : ArrayList<Card>

        +Hand()
        +add(card : Card) : void
        +remove(card : Card) : void
        +getHand() : ArrayList<Card>
        +getTotalPoints() : int
        +size() : int
        +isEmpty() : boolean
        +clear() : void
    }

        Deck *-left- Card
        DiscardPile o-left- Card
        Hand o-- Card
}

package "uno.player" {
    abstract class Player {
        #name : String
        #hand : Hand

        +Player(name : String)
        +getName() : String
        +getHand() : Hand
        {abstract} +isHuman() : boolean
    }
    class HumanPlayer {
        {abstract} +isHuman() : boolean
    }
    class AIPlayer {
        {abstract} +isHuman() : boolean
    }

        Player <|-right- HumanPlayer
        Player <|-left- AIPlayer

        Player *-left- Hand
}

package "uno.rules" {
    class Scoreboard {
        - {static} TARGET_SCORE : int = 500
        - scores : Map<Player, Integer>

        + addPoints(winner : Player, players : List<Player>) : int
        + getScore(player : Player) : int
        + hasWinner() : boolean
        + getWinner() : Player
    }
    class MoveValidator {
        +isLegalPlay(card : Card, color : CardColor) : boolean
        +hasPlayableCard(hand : Hand, top : Card, color : CardColor) : boolean
    }
}

package "uno.game" {
    enum Direction {
        CLOCKWISE
        COUNTER_CLOCKWISE
    }

    class Game {
        -players : List<Player>
        -scoreBoard : Scoreboard
        -validator : MoveValidator
        -currentRound : Round
    }
    enum RoundPhase {
        AWAITING_PLAY
        DRAWN_CARD
        CHOOSING_COLOR
        ROUND_OVER
    }

    class TurnManager {
        -players : List<Player>
        -currentIndex : int
        -direction : Direction
        -skips : int

        +TurnManager(players : List<Player>)
        +TurnManager(players : List<Player>, startIndex : int)
        +getCurrentPlayer() : Player
        +getNextPlayer() : Player
        +getDirection() : Direction
        +reverse() : void
        +skip() : void
        +endTurn() : void
        +nextSeat(currentSeat : int, steps : int) : int
    }

    class Round {
        -players : List<Player>
        -deck : Deck
        -discardPile : DiscardPile
        -moveValidator : MoveValidator
        -turnManager : TurnManager
        -phase : RoundPhase
        -drawnCard : Card
        -pendingWild : Card

        +Round(players : List<Player>, validator : MoveValidator)
        +getPhase() : RoundPhase
        +getCurrentPlayer() : Player
        +getDirection() : Direction
        +playCard(card : Card) : void
        +drawCard() : void
        +pass() : void
        +chooseColor(color : CardColor) : void
        +skipNextPlayer() : void
        +reverseDirection() : void
        +nextPlayerDraws(count : int) : void
    }

        Game *-- Round
        Game *-right- Scoreboard
        Game *-- Player
        Game -right-> MoveValidator


        Round *-- Deck
        Round *-- DiscardPile
        Round --> Player
        Round -up-> MoveValidator
        Round *-- TurnManager
        Round --> RoundPhase
        Round ..|> CardEffectContext
        TurnManager -left-> Direction
        TurnManager --> Player
}

package "uno.app" {
    class main {
        {static} +main(args : String[]) : void
    }

        main --> Game
}
@enduml